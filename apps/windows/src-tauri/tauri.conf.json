{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=frontend",
    "beforeBuildCommand": "npm run build --workspace=frontend",
    "devPath": "http://localhost:3000",
    "distDir": "../../frontend/dist"
  },
  "package": {
    "productName": "NEXUS AI",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": { "open": true }
    },
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis"],
      "icon": [
        "icons/icon.ico",
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.icns"
      ],
      "identifier": "com.nexus.ai"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "NEXUS AI",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
