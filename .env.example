# NEXUS AI - Configuration Variables
# Copy this file to .env and fill in your values

# Application Settings
NEXUS_APP_NAME=NEXUS AI
NEXUS_APP_VERSION=1.0.0
NEXUS_ENVIRONMENT=development  # development, staging, production
NEXUS_LOG_LEVEL=INFO
NEXUS_API_PORT=8000
NEXUS_FRONTEND_PORT=3000
NEXUS_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database Configuration (PostgreSQL recommended)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexus_ai
# Alternative SQLite for development:
# DATABASE_URL=sqlite+aiosqlite:///./nexus_ai.db

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider Configuration
# FREE MODE: Only configure providers with free access
FREE_MODE_ENABLED=true
FREE_MODE_STRICT=true  # Block all paid routes

# DeepSeek API
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
GOOGLE_GEMINI_MODEL=gemini-pro

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# OpenAI (Paid - disabled in FREE MODE)
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORGANIZATION=your-org-id
OPENAI_MODEL=gpt-4

# File Storage
FILE_STORAGE_BASE_PATH=./storage
FILE_STORAGE_MAX_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=.txt,.py,.js,.ts,.jsx,.tsx,.json,.md,.yml,.yaml,.xml,.html,.css

# Security Settings
AGENT_MAX_CONCURRENT_TASKS=5
AGENT_TIMEOUT_SECONDS=300
AGENT_MAX_FILE_SIZE_MB=10
AGENT_ALLOWED_DIRECTORIES=./projects,./workspace
AGENT_BLOCKED_DIRECTORIES=./.env,./secrets,./keys,/windows,/system32

# Task Orchestration
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY_SECONDS=5
TASK_PURGE_COMPLETED_DAYS=30

# Memory & Learning
MEMORY_ENABLED=true
MEMORY_MAX_ENTRIES=10000
LEARNING_ADAPTIVE_ROUTING_ENABLED=true
LEARNING_EVALUATION_WINDOW_DAYS=30

# Windows Agent
WINDOWS_AGENT_ENABLED=true
WINDOWS_ALLOWED_SHELLS=powershell,cmd
WINDOWS_MAX_COMMAND_TIME_SECONDS=60
WINDAGS_MAX_OUTPUT_SIZE_KB=1024

# Android App
ANDROID_APP_ID=ai.nexus.platform
ANDROID_APP_NAME=NEXUS AI
ANDROID_MIN_SDK_VERSION=24
ANDROID_TARGET_SDK_VERSION=34

# Device Pairing
DEVICE_PAIRING_ENABLED=true
DEVICE_PAIRING_TIMEOUT_MINUTES=10
DEVICE_PAIRING_MAX_DEVICES=5

# Monitoring & Logging
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_ENABLED=false

# Development
DEBUG=true
RELOAD_ON_CHANGE=true
TEST_MODE=false